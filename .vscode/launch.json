{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wails: debug Go (frontend dev server must be running)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "buildFlags": "-tags dev,webkit2_41 -gcflags=all=-N -l",
      "env": {
        "FRONTEND_DEVSERVER_URL": "http://localhost:5173"
      },
      "preLaunchTask": "frontend: dev server"
    },
    {
      "name": "Go: debug current test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "buildFlags": "-tags webkit2_41"
    }
  ]
}
