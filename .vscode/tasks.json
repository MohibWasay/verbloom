{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: dev server",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegin": "VITE",
          "activeEnd": "Local:"
        }
      }
    },
    { "label": "make: check", "type": "shell", "command": "make check", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$go"] },
    { "label": "make: test", "type": "shell", "command": "make test", "group": "test", "problemMatcher": ["$go"] },
    { "label": "make: lint", "type": "shell", "command": "make lint", "problemMatcher": ["$go", "$eslint-stylish"] },
    { "label": "wails: dev", "type": "shell", "command": "make dev", "isBackground": true, "problemMatcher": [] },
    { "label": "wails: build", "type": "shell", "command": "make build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$go"] }
  ]
}
